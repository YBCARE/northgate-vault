# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
RESEND_API_KEY=re_...
ADMIN_EMAIL=ops@example.com
PORT=4000

# Required for the custody tracking admin panel (/admin)
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=random-long-string-for-signing-session-cookies

# Optional: use a sender address verified in Resend for production.
EMAIL_FROM=Northgate Vault <inquiries@your-domain.com>

# Optional when frontend and API are deployed to different domains.
CORS_ORIGIN=https://your-frontend.onrender.com

# Optional: overrides the base URL used to build links/images in status
# emails (track links, the banner image). On Render this is normally
# unnecessary — RENDER_EXTERNAL_URL is provided automatically. Set this only
# for local testing or a non-Render host.
PUBLIC_BASE_URL=https://northgate-vault.onrender.com
